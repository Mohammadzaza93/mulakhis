# انسخ هذا الملف إلى .env ثم عدّل القيم. لا ترفع .env إلى Git.

# التلخيص وقراءة الصور (Claude)
ANTHROPIC_API_KEY=sk-ant-ضع-مفتاحك-هنا
SUMMARY_MODEL=claude-haiku-5-5

# تحويل الصوت إلى نص (Whisper API من OpenAI)
OPENAI_API_KEY=sk-ضع-مفتاحك-هنا
STT_MODEL=whisper-1

# الحسابات: سر طويل وعشوائي (مثلاً: python3 -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=
DB_PATH=mulakhis.db
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# حدود الاستخدام الشهري
FREE_MONTHLY_LIMIT=5
PRO_MONTHLY_LIMIT=300

# تحديد معدل الطلبات (لكل IP)
RATE_LIMIT_AUTH=20
RATE_LIMIT_AUTH_WINDOW=60
RATE_LIMIT_GENERAL=120
RATE_LIMIT_GENERAL_WINDOW=60

# الاشتراكات: القيمة نفسها تضعها في إعدادات Webhook داخل RevenueCat (رأس Authorization)
REVENUECAT_WEBHOOK_AUTH=

# البريد الإلكتروني (اختياري) لإعادة تعيين كلمة المرور
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=1
APP_URL=

MAX_FILE_MB=15
MAX_TEXT_CHARS=200000
CORS_ORIGINS=*

# للتطوير فقط: ناتج تجريبي بدون استدعاء الذكاء الاصطناعي
MOCK_AI=0
# للتطوير فقط: يسمح بسر JWT افتراضي (لا تستخدمه في الإنتاج)
ALLOW_DEV_SECRET=0
