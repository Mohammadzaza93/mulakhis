# انسخ هذا الملف إلى .env ثم عدّل القيم. لا ترفع .env إلى Git.

# التلخيص وقراءة الصور (Claude)
ANTHROPIC_API_KEY=sk-ant-ضع-مفتاحك-هنا
SUMMARY_MODEL=claude-haiku-5-5

# تحويل الصوت إلى نص (Whisper API من OpenAI)
OPENAI_API_KEY=sk-ضع-مفتاحك-هنا
STT_MODEL=whisper-1

# الحسابات: سر طويل وعشوائي
JWT_SECRET=
DB_PATH=mulakhis.db

# حدود الاستخدام الشهري
FREE_MONTHLY_LIMIT=5
PRO_MONTHLY_LIMIT=300

REVENUECAT_WEBHOOK_AUTH=

MAX_FILE_MB=15
MAX_TEXT_CHARS=200000
CORS_ORIGINS=*

RATE_LIMIT_AUTH=20
RATE_LIMIT_AUTH_WINDOW=60
RATE_LIMIT_GENERAL=120
RATE_LIMIT_GENERAL_WINDOW=60

# SMTP optional
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@mulakhis.app
# RESET_LINK_BASE=mulakhis://reset
# RETURN_RESET_TOKEN=0

MOCK_AI=0
ALLOW_DEV_SECRET=0

GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
